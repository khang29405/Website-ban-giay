PORT=5000

DB_SERVER=localhost
# Neu dung named instance (vd: SQLEXPRESS) thi khai bao DB_INSTANCE va bo qua DB_PORT
DB_INSTANCE=SQLEXPRESS
DB_PORT=1433
DB_NAME=ShoeStoreDB
DB_USER=sa
DB_PASSWORD=changeme
DB_ENCRYPT=false

JWT_SECRET=changeme
JWT_EXPIRES_IN=1d

# SMTP dung de gui email dat lai mat khau (Sprint 4). Vi du dung Gmail:
# phai bat 2-Step Verification cho tai khoan Gmail roi tao "App password"
# tai https://myaccount.google.com/apppasswords (mat khau Gmail thuong se KHONG dung duoc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<email_gui@gmail.com>
SMTP_PASS=<app_password_16_ky_tu>

# Cloudinary dung de luu anh san pham (Sprint 4 - upload anh thay vi dan URL).
# Dang ky tai khoan mien phi tai https://cloudinary.com, lay 3 gia tri nay o Dashboard.
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>
